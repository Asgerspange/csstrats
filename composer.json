{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.0",
        "google/apiclient": "^2.19",
        "guzzlehttp/guzzle": "^7.2",
        "ilzrv/laravel-steam-auth": "^3.1",
        "laravel/cashier": "^15.3",
        "laravel/cashier-paddle": "^2.8",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.13",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.20",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.5",
        "predis/predis": "^3.4",
        "socialiteproviders/faceit": "*",
        "socialiteproviders/manager": "^4.8",
        "stevebauman/location": "^7.5",
        "stripe/stripe-php": "^16.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:work redis\" \"npm run dev\" --names='server,queue,vite'"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "10.x-dev"
        },
        "laravel": {
            "dont-discover": ["laravel/telescope"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
